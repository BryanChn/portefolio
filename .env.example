# Copier ce fichier en .env.local et remplir les valeurs (.env.local n'est jamais commité)
RESEND_API_KEY=
# Adresse qui reçoit les messages (doit être celle de ton compte Resend tant qu'aucun domaine n'est vérifié)
CONTACT_TO_EMAIL=
# Cloudflare Turnstile (anti-spam) : clés du widget sur https://dash.cloudflare.com → Turnstile
# Sans ces deux variables, le formulaire fonctionne sans captcha (honeypot + rate limit uniquement)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
